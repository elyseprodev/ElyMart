# Keep real values in .env.local or your hosting provider's environment settings.
# Never commit actual credentials.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-new-unique-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Required for email one-time codes. Use your email provider's SMTP settings.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=replace-with-an-smtp-app-password
SMTP_FROM="ElyMart Admin <admin@example.com>"
